# =====================================================================
# Variables de entorno del ecosistema (docker compose las lee de .env)
# Copia este archivo a .env y rellena los valores:  cp .env.example .env
# Nunca subas el archivo .env al repositorio: contiene secretos.
# =====================================================================

# ---------- Base de datos (servicio: db) ----------

# Contraseña del usuario root de MySQL. Solo para administración;
# la aplicación NO la usa (principio de mínimo privilegio).
MYSQL_ROOT_PASSWORD=

# Nombre de la base de datos que MySQL crea en el primer arranque.
MYSQL_DATABASE=e_commerce

# Usuario de la aplicación, con permisos solo sobre MYSQL_DATABASE.
# Laravel se conecta con este usuario (DB_USERNAME).
MYSQL_USER=ec_user

# Contraseña del usuario de la aplicación (DB_PASSWORD en Laravel).
MYSQL_PASSWORD=

# ---------- API Laravel (servicio: backend) ----------

# Clave de cifrado de Laravel (sesiones, cookies, datos cifrados).
# Genérala con: docker compose run --rm backend php artisan key:generate --show
APP_KEY=

# Secreto para firmar los tokens JWT de autenticación (tymon/jwt-auth).
# Genérala con: docker compose run --rm backend php artisan jwt:secret --show
JWT_SECRET=

# Clave publicable de Stripe para el backend (pk_test_... en modo prueba).
STRIPE_KEY=

# Clave secreta de Stripe (sk_test_... en modo prueba). Es privada:
# solo la usa la API, nunca el frontend.
STRIPE_SECRET=

# ---------- Frontend Next.js (servicio: frontend) ----------

# Clave publicable de Stripe que usa el navegador (pk_test_...).
# Se incrusta en el JavaScript durante el build (build arg), por eso
# lleva el prefijo NEXT_PUBLIC_. Si la cambias, reconstruye la imagen.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
